{
  "name": "graphql-gateway",
  "version": "1.0.0",
  "description": "Vehicle data GraphQL gateway backed by MongoDB and NHTSA XML ingestion",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/megha201095/graphql-gateway.git"
  },
  "keywords": [
    "graphql",
    "nhtsa",
    "mongodb",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/megha201095/graphql-gateway/issues"
  },
  "homepage": "https://github.com/megha201095/graphql-gateway#readme",
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^4.5.0",
    "graphql": "^16.14.2",
    "mongodb": "^6.12.0",
    "pino": "^9.1.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
